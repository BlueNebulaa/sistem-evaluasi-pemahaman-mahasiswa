# Salin file ini jadi .env lalu isi nilainya
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Naikkan untuk video panjang (1000 = hanya ~33 detik pertama @30fps)
EYE_MAX_FRAMES=1000
EYE_FRAME_SKIP=2

# ===== RAG (rag/) =====
# Qdrant Cloud
cluster_endpoint=
api_qdrant_interview=

# LLM untuk assessment: ollama (lokal) atau openrouter
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
RAG_TOP_K=3

# Ollama — jalankan dulu: ollama pull qwen3:4b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_REASONING=true

# OpenRouter — hanya dipakai kalau LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
